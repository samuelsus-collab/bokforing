# ── Databas ────────────────────────────────────────────────────────────────
POSTGRES_USER=bokforing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bokforing
# Anslutning som backend använder (matchar docker-compose postgres-tjänsten)
DATABASE_URL=postgresql://bokforing:change-me@localhost:5432/bokforing?schema=public

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3101
NODE_ENV=development
FRONTEND_URL=http://localhost:5273

# ── Seed (första användaren) ─────────────────────────────────────────────────
SEED_USER_EMAIL=admin@firma.se
SEED_USER_PASSWORD=bokfor123
SEED_COMPANY_NAME=Min Enskilda Firma
