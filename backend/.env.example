# Kopiera till backend/.env och fyll i värdena.
# Databasanslutning (matchar docker-compose-tjänsten postgres).
DATABASE_URL=postgresql://bokforing:bokforing@localhost:5432/bokforing?schema=public

# Auth
JWT_SECRET=byt-detta-till-nagot-langt-och-hemligt-minst-16-tecken
